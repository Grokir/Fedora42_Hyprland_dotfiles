
@theme "~/.config/rofi/themes/rofi-themes-collection/themes/launchpad.rasi"

configuration {
    /* Основные настройки */
    mode: "drun";  // Режим по умолчанию: drun (запуск приложений из .desktop файлов)
    show-icons: true;  // Показывать иконки приложений

    /* Дополнительные опции для улучшения (необязательно, но полезно) */
    // icon-theme: "Papirus";  // Тема иконок (замените на вашу, например "Adwaita" или "hicolor")
    display-drun: "Apps";  // Текст в строке ввода
    drun-display-format: "{name}";  // Формат отображения: только имя приложения (можно добавить {icon} или {exec})

    /* Внешний вид (тема) */
    font: "JetBrains Mono 15";  // Шрифт (замените на свой)
    width: 50;  // Ширина окна в процентах от экрана
    lines: 10;  // Количество строк в списке
    columns: 1;  // Количество колонок

    /* Цвета (пример тёмной темы) */
    // bg: #282a36;  // Фон
    // fg: #f8f8f2;  // Текст
    // hlbg: #44475a;  // Фон выделенного элемента
    // hlfg: #bd93f9;  // Текст выделенного элемента
    // border: #6272a4;  // Цвет границы
    // separator: #6272a4;  // Цвет разделителя

    /* Поведение */
    case-sensitive: false;  // Поиск без учёта регистра
    cycle: true;  // Циклический выбор элементов стрелками
    scrollbar: false;  // Скрыть полоску прокрутки
    fake-transparency: true;  // Псевдо-прозрачность для композитных менеджеров
}

