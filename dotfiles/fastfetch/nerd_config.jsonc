{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // "source": "fedora_small", // search for logos: fastfetch --list-logos or --print-logos
        // "source": "sabotage", // search for logos: fastfetch --list-logos or --print-logos
        "source": "puffos", // search for logos: fastfetch --list-logos or --print-logos
        // "source": "netbsd_small", // search for logos: fastfetch --list-logos or --print-logos
        "padding": {
	        "top": 1,
	        "left": 2
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
	"break",
	"title",
        {
            "type": "os",
            "format": "{2} {9}",
            "key": " ",
        },
        {   "type": "wm",
            "key" : "󰧨 ",
        },
        {   "type": "de",
            "key" : " ",
        },       {
            "type": "packages",
            // "format": "{} (dnf)",
            "key": "󰏖 ", 
        },
        {   "type": "shell",
            "key": "󰆍 ",
        },
        {
            "type": "kernel",
            "key": " ",
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "key": "󰄉 ",
        },
        {
            "type": "command",
            "key": " ",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s);    days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days"
        },
        {
            "type": "memory",
            "key": "󰍛 ",
        },
        {
            "type": "localip",
            "key": "󰩠 ",
        },
        {
            "type": "publicip",
            "format": "{ip}",
            "key": " ",
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
        //"break",
        "break"
    ]
}
